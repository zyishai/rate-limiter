{
  "name": "rate-limiter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc && tsc -p load",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "load": "node load/run.ts",
    "load:summarize": "node load/summarize.ts",
    "load:report": "node load/report.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/k6": "2.3.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
